---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { comparePosts } from '../../lib/posts';
import { SITE } from '../../config';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(comparePosts);
---

<BaseLayout title="全部文章" description={`${SITE.title} 的全部 ${posts.length} 篇文章。`}>
  <div class="shell narrow page-section">
    <header class="page-heading">
      <p class="eyebrow">ALL POSTS</p>
      <h1>全部文章</h1>
      <p>共 {posts.length} 篇，记录算法、学习与生活。</p>
    </header>
    <section class="post-list" aria-label="文章列表">
      {posts.map((post) => <PostCard post={post} />)}
      {posts.length === 0 && <p>暂时没有公开文章，欢迎以后再来。</p>}
    </section>
  </div>
</BaseLayout>

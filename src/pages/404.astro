---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="你访问的页面不存在。" noindex>
  <div class="shell error-page">
    <p class="error-code">404</p>
    <h1>这里没有这一页</h1>
    <p>链接可能已经写错，或者页面暂时搬了家。</p>
    <a class="button-link" href="/">回到首页</a>
  </div>
</BaseLayout>

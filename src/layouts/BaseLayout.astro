---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { SITE } from '../config';
import { absoluteUrl } from '../lib/urls';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  hero?: boolean;
  publishedTime?: Date;
  updatedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.hero,
  type = 'website',
  hero = false,
  publishedTime,
  updatedTime,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const site = Astro.site ?? new URL('https://miuyou.github.io/Blog/');
const canonical = absoluteUrl(Astro.url.pathname, site);
const socialImage = absoluteUrl(image, site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={absoluteUrl('/index.xml', site)} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = savedTheme ?? (prefersDark ? 'dark' : 'light');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <SiteHeader hero={hero} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
